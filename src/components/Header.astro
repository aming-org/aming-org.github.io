---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS, SITE } from '@/consts';
import { isActivePath, withBase } from '@/utils/url';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase('/')}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__text misprint">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        NAV_LINKS.map((link) => (
          <a
            class="nav__link"
            href={withBase(link.href)}
            aria-current={isActivePath(current, link.href) ? 'page' : undefined}
          >
            <span class="nav__zh">{link.label}</span>
            <span class="nav__en">{link.en}</span>
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
  }

  /* 品牌区 */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand__mark {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 100px;
    background: var(--vermilion);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--vermilion) 16%, transparent);
    transition: transform var(--transition), background var(--transition);
  }

  .brand:hover .brand__mark {
    transform: scale(1.25);
    background: var(--teal);
  }

  .brand__text {
    font-family: var(--font-serif);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* 导航 */
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.1rem, 1.4vw, 0.5rem);
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav__link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    padding: 0.35rem 0.62rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color var(--transition), background var(--transition);
  }

  .nav__link:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--sand) 32%, transparent);
  }

  .nav__link[aria-current='page'] {
    color: var(--ink);
  }

  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: -0.1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 100px;
    background: var(--vermilion);
  }

  .nav__zh {
    font-size: 0.92rem;
    line-height: 1.25;
  }

  .nav__en {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
    line-height: 1;
  }

  /* 右侧动作区 */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--border);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .nav__en {
      display: none;
    }

    .nav__link {
      padding-inline: 0.45rem;
    }

    .actions {
      padding-left: 0.35rem;
      gap: 0.25rem;
    }
  }

  @media (max-width: 480px) {
    .brand__text {
      font-size: 1.08rem;
    }

    .nav {
      gap: 0;
    }

    .nav__link {
      padding-inline: 0.34rem;
    }

    .nav__zh {
      font-size: 0.86rem;
    }

    .actions {
      border-left: none;
      padding-left: 0.2rem;
    }
  }
</style>
