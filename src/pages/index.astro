---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts } from '@/utils/posts';
import { formatChars, formatReadingTime, stats } from '@/utils/stats';
import { withBase } from '@/utils/url';

const posts = await getPublishedPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero__copy">
      <p class="eyebrow">Short Stories</p>

      <h1 class="hero__title">
        <span class="misprint">番茄贩卖商</span><br />
        <span class="hero__title-sub">只卖短篇</span>
      </h1>

      <p class="hero__lead">
        摊位上只摆虚构的故事。路过的人可以随便翻，读完就走。
      </p>

      <div class="hero__actions">
        <a class="btn" href={withBase('/posts')}>
          开始阅读
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.5 8h11m-4-4 4 4-4 4"
            />
          </svg>
        </a>
      </div>
    </div>

    <span class="hero__blob" aria-hidden="true"></span>
  </section>

  <section class="wrap block">
    <header class="block__head">
      <p class="eyebrow">Latest Stories</p>
      <a class="block__more" href={withBase('/posts')}>全部 {posts.length} 篇 →</a>
    </header>

    <div class="posts">
      {featured && <PostCard post={featured} featured />}
      {rest.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(
      175deg,
      color-mix(in srgb, var(--honey) 9%, transparent),
      transparent 55%
    );
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    padding-block: clamp(3.25rem, 8vw, 6rem);
  }

  .hero__title {
    margin-top: 1.15rem;
    font-size: var(--step-4);
    line-height: 1.06;
  }

  .hero__title-sub {
    color: var(--fg-muted);
    font-weight: 400;
    font-style: italic;
  }

  .hero__lead {
    max-width: 34ch;
    margin-top: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.72;
    color: var(--fg-muted);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.2rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--fg-faint);
  }

  .hero__stats-dot {
    margin-inline: 0.45rem;
    opacity: 0.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .hero__actions svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  /* 背景网点圆：复古印刷的装饰，不抢内容 */
  .hero__blob {
    position: absolute;
    top: -20%;
    right: -6%;
    width: 26rem;
    height: 26rem;
    border-radius: 100%;
    background-image: radial-gradient(
      color-mix(in srgb, var(--vermilion) 42%, transparent) 1.8px,
      transparent 1.9px
    );
    background-size: 10px 10px;
    mask-image: radial-gradient(circle at center, #000 30%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* ---------------- 区块 ---------------- */
  .block {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .block__head {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .block__head .eyebrow {
    flex: 1;
  }

  .block__more {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .block__more:hover {
    color: var(--accent);
  }

  .posts {
    display: grid;
    gap: 0.9rem;
  }

  @media (max-width: 900px) {
    .hero__lead {
      max-width: 48ch;
    }

    .hero__blob {
      top: auto;
      bottom: -30%;
      right: -30%;
      width: 20rem;
      height: 20rem;
    }
  }
</style>
