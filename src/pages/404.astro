---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/utils/url';
---

<BaseLayout title="404" description="这个页面不存在。">
  <div class="wrap nf">
    <p class="nf__code misprint">404</p>
    <h1 class="nf__title">这个摊位上没有你要找的故事</h1>
    <p class="nf__body">
      或许已经收摊了，或许从来没有摆出来过。
    </p>

    <div class="nf__actions">
      <a class="btn" href={withBase('/')}>回到首页</a>
      <a class="btn btn--ghost" href={withBase('/posts')}>浏览作品</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(4rem, 12vw, 8rem);
  }

  .nf__code {
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 16vw, 9rem);
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
  }

  .nf__title {
    margin-top: 1.25rem;
    font-size: var(--step-2);
  }

  .nf__body {
    max-width: 34ch;
    margin-top: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.75;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
  }
</style>
